XAI_API_KEY=your_full_xai_api_key
# Optional: overrides the xAI endpoint in utils/ai.config.js.
# XAI_BASE_URL=https://api.x.ai/v1
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Required to unlock external tool controls in the browser.
JARVIS_CONTROL_TOKEN=replace_with_a_long_random_secret

# Set the same stable secret on every backend instance in production.
# JARVIS_VISITOR_SECRET=replace_with_a_different_long_random_secret

# Point to a server implementing the hotel provider contract in README.md.
HOTEL_PROVIDER_BASE_URL=https://your-hotel-provider.example/api/
HOTEL_PROVIDER_API_KEY=your_server_side_provider_key

# Digimenu menu integration.
DIGIMENU_ENV=production
# DIGIMENU_MENU_PATH=/api/restaurant/get_menu_items_by_taguid
DIGIMENU_TAG_UID=04AC71D2141990
# DIGIMENU_RESTAURANT_ID=128
# DIGIMENU_TABLE_ID=356
# DIGIMENU_TIMEOUT_MS=12000

# ElevenLabs TTS. Keep these values server-side; never expose them to the browser.
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32
